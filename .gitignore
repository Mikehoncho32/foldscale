# Xcode project is generated by xcodegen — never commit it (handoff §3)
*.xcodeproj
*.xcworkspace
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/

# Release artifacts (Scripts/build-dmg.sh) and the CI package cache
/dist/
/.spm/

# Sparkle private key exports (generate_keys -x) must never be committed
*.key

# Benchmark fixtures & traces (large / generated by Scripts/)
/Fixtures/
*.trace

# macOS
.DS_Store
